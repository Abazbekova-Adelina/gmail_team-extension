{
  "manifest_version": 3,
  "name": "Gmail Team Chat",
  "version": "0.3.0",
  "description": "Private team workspaces and discussions under Gmail threads",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "identity",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "action": {
    "default_title": "Gmail Team Chat settings",
    "default_popup": "settings.html?popup=1"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "invite-bridge.js",
    "scripts": ["invite-bridge.js"]
  },
  "externally_connectable": { "matches": ["https://gmail-team-chat.vercel.app/*"] },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "chat.html"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}
