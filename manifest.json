{
  "manifest_version": 3,
  "name": "Gmail Team Chat",
  "version": "0.2.0",
  "description": "A shared chat under Gmail conversations",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["identity"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["chat.html"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
